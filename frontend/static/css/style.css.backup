
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');

:root {
    --bg: #f4f7f9;
    --white: #ffffff;
    --primary: #087f78;
    --primary-light: #e4f5f2;
    --dark: #172b35;
    --muted: #82919a;
    --border: #e8edef;
    --sidebar: #142b35;
}

* { box-sizing: border-box; }

body {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--dark);
}

.app-container { display: flex; min-height: 100vh; }

.sidebar {
    width: 255px;
    background: var(--sidebar);
    color: white;
    padding: 25px 17px;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.brand { display: flex; gap: 12px; align-items: center; margin-bottom: 45px; }
.brand-icon {
    background: var(--primary);
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-size: 23px;
    font-weight: 800;
}
.brand h2 { margin: 0; font-size: 17px; letter-spacing: 1px; }
.brand small { color: #9fb5bd; font-size: 10px; }

.nav-label {
    color: #8299a2;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin: 20px 10px 12px;
}

nav { display: grid; gap: 6px; }

.nav-item {
    color: #b6c7cc;
    text-decoration: none;
    padding: 12px;
    border-radius: 9px;
    font-size: 13px;
    transition: .2s;
}

.nav-item:hover, .nav-item.active {
    background: #23434c;
    color: white;
}

.nav-item.active { border-left: 3px solid #28b7a5; }

.sidebar-bottom { margin-top: auto; }
.user-card { display: flex; align-items: center; gap: 11px; padding: 13px 5px; }
.avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #287f79;
    display: grid;
    place-items: center;
    font-weight: 700;
}
.user-info { display: grid; gap: 3px; }
.user-info strong { font-size: 12px; }
.user-info small { color: #a2b5ba; font-size: 10px; }

.logout-btn {
    width: 100%;
    background: transparent;
    color: #d4e1e4;
    border: 1px solid #35515a;
    border-radius: 8px;
    padding: 11px;
    cursor: pointer;
}

.main-content { flex: 1; min-width: 0; padding: 30px 38px; }

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.breadcrumb { color: var(--muted); font-size: 11px; margin-bottom: 7px; }
.breadcrumb span { color: var(--primary); }
.topbar h1 { margin: 0; font-size: 25px; }

.topbar-right { font-size: 12px; color: #60747c; display: flex; align-items: center; gap: 8px; }
.status-indicator { width: 8px; height: 8px; border-radius: 50%; background: #20b58b; }

.welcome {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(110deg, #e1f5f1, #eff9f7);
    border: 1px solid #d5ece7;
    padding: 25px;
    border-radius: 13px;
    margin-bottom: 23px;
}
.welcome h2 { margin: 0 0 7px; font-size: 19px; }
.welcome p { margin: 0; color: #70858b; font-size: 12px; }
.date-label { font-size: 12px; color: #557a77; }

.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 17px; margin-bottom: 22px; }
.stat-card, .panel {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 21px;
}
.stat-card span { font-size: 12px; color: var(--muted); }
.stat-card h2 { font-size: 29px; margin: 12px 0 5px; }
.stat-card small { color: #9aa8ae; font-size: 10px; }

.content-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 20px; }
.panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
.panel h3, .panel-header h3 { margin: 0; font-size: 15px; }
.text-button { background: none; border: 0; color: var(--primary); cursor: pointer; }

.system-item {
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    font-size: 12px;
}
.healthy { color: #159b77; font-size: 11px; }

.search-input {
    width: 100%;
    padding: 13px 15px;
    border: 1px solid var(--border);
    border-radius: 8px;
    outline: none;
    font: inherit;
    margin-bottom: 17px;
}
.search-input:focus { border-color: var(--primary); }

.primary-btn {
    background: var(--primary);
    color: white;
    border: 0;
    border-radius: 8px;
    padding: 12px 20px;
    cursor: pointer;
}

.table-container { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 12px; }
th, td { padding: 13px 10px; border-bottom: 1px solid var(--border); text-align: left; }
th { color: var(--muted); font-weight: 600; }
td { color: #4e636c; }

.page { display: none; }
.page.active { display: block; }

.notification {
    position: fixed;
    bottom: 25px;
    right: 25px;
    background: var(--dark);
    color: white;
    padding: 13px 20px;
    border-radius: 8px;
    display: none;
    font-size: 12px;
}

@media(max-width: 1000px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .content-grid { grid-template-columns: 1fr; }
}
@media(max-width: 650px) {
    .sidebar { width: 75px; padding: 15px 8px; }
    .brand h2, .brand small, .nav-label, .nav-item, .user-info, .logout-btn { font-size: 0; }
    .brand-icon { margin: auto; }
    .nav-item { overflow: hidden; white-space: nowrap; }
    .main-content { padding: 20px 13px; }
    .stats-grid { grid-template-columns: 1fr 1fr; }
}


#login-screen {
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: #142b35;
    padding: 20px;
}

.login-card {
    background: white;
    width: min(420px, 100%);
    padding: 40px;
    border-radius: 16px;
    text-align: center;
}

.login-card .brand-icon { margin: auto; }
.login-card h1 { letter-spacing: 2px; margin-bottom: 5px; }
.login-card > p { color: #82919a; font-size: 12px; margin-bottom: 30px; }

.login-card form { text-align: left; }
.login-card label { display: block; font-size: 12px; margin: 17px 0 7px; }

.login-card input {
    width: 100%;
    padding: 13px;
    border: 1px solid #e0e7e9;
    border-radius: 8px;
    outline: none;
}

.login-card .primary-btn { width: 100%; margin-top: 24px; }
#login-error { color: #d04444; font-size: 12px; }

.result-card {
    background: #f5f9f9;
    padding: 18px;
    margin-top: 20px;
    border-radius: 10px;
    font-size: 12px;
}

.result-card pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 11px;
}

.result-card p { color: #71838a; }
